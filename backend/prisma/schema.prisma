generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// Organization (Clínica / Tenant)
// ──────────────────────────────────────────────

enum ClinicAccessStatus {
  ACTIVE
  BLOCKED
}

// Hipóteses legais Art. 11 LGPD para tratamento de dados sensíveis de saúde
enum SensitiveLegalBasis {
  // Art. 11, I — consentimento específico e destacado do titular
  CONSENT
  // Art. 11, II, a — cumprimento de obrigação legal ou regulatória
  LEGAL_OBLIGATION
  // Art. 11, II, b — execução de políticas públicas
  PUBLIC_POLICY
  // Art. 11, II, c — estudos por órgão de pesquisa (anonimizados)
  RESEARCH
  // Art. 11, II, f — exercício regular de direitos em contrato ou processo
  CONTRACT_EXECUTION
  // Art. 11, II, h — tutela da saúde por profissional habilitado (default clínico)
  HEALTH_PROTECTION
  // Art. 11, II, i — prevenção à fraude e segurança
  FRAUD_PREVENTION
}

enum DocumentType {
  CNPJ
  CPF
}

enum PlanStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

enum VoidingLeakageAmount {
  SMALL
  MODERATE
  LARGE
}

enum BowelEffort {
  NONE
  LIGHT
  MODERATE
  INTENSE
}

enum BowelSensation {
  COMPLETE
  INCOMPLETE
}

enum BowelLeakageType {
  GAS
  STOOL
  GAS_AND_STOOL
}

model Organization {
  id                  String             @id @default(uuid())
  name                String
  document            String?            @unique @map("document")
  documentType        DocumentType?      @map("document_type")
  email               String?
  phone               String?
  legalName           String?            @map("legal_name")
  stateRegistration   String?            @map("state_registration")
  addressCep          String?            @map("address_cep")
  addressStreet       String?            @map("address_street")
  addressNumber       String?            @map("address_number")
  addressComplement   String?            @map("address_complement")
  addressNeighborhood String?            @map("address_neighborhood")
  addressCity         String?            @map("address_city")
  addressState        String?            @map("address_state")
  settings            Json?
  accessStatus        ClinicAccessStatus @default(ACTIVE) @map("access_status")
  planMaxUsers        Int?               @map("plan_max_users")
  planMaxPatients     Int?               @map("plan_max_patients")
  plan                String             @default("SOLO") @map("plan")
  planStatus          PlanStatus         @default(TRIAL) @map("plan_status")
  trialEndsAt         DateTime?          @map("trial_ends_at")
  founderDiscount     Boolean            @default(false) @map("founder_discount")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  users               OrganizationUser[]
  patients            Patient[]
  procedures          Procedure[]
  appointments        Appointment[]
  agendaBlocks        AgendaBlock[]
  anamneses           Anamnesis[]
  perinealAssessments PerinealAssessment[]
  evolutions          Evolution[]
  financialRecords    FinancialRecord[]
  treatmentPackages   TreatmentPackage[]
  clinicDocuments     ClinicDocument[]
  tasks               Task[]

  @@map("organizations")
}

// ──────────────────────────────────────────────
// Person (global user, identified by CPF)
// ──────────────────────────────────────────────

model Person {
  id           String   @id @default(uuid())
  cpf          String   @unique
  name         String
  email        String   @unique
  phone        String?
  passwordHash String   @map("password_hash")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  organizationUsers OrganizationUser[]
  refreshTokens     RefreshToken[]
  deviceTokens      DeviceToken[]

  @@map("persons")
}

// ──────────────────────────────────────────────
// RefreshToken — refresh tokens com rotação
// Apenas o hash do jti é persistido; o JWT em claro vive somente no cookie httpOnly
// ──────────────────────────────────────────────

model RefreshToken {
  id        String    @id @default(uuid())
  personId  String    @map("person_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ──────────────────────────────────────────────
// OrganizationUser (Person ↔ Organization link)
// ──────────────────────────────────────────────

enum Role {
  ADMIN
  PROFESSIONAL
  RECEPTIONIST
}

model OrganizationUser {
  id                       String   @id @default(uuid())
  organizationId           String   @map("organization_id")
  personId                 String   @map("person_id")
  role                     Role     @default(PROFESSIONAL)
  permissions              Json?
  active                   Boolean  @default(true)
  specialty                String?  @map("specialty")
  professionalRegistration String?  @map("professional_registration")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  person       Person       @relation(fields: [personId], references: [id])

  appointments        Appointment[]
  agendaBlocks        AgendaBlock[]
  anamneses           Anamnesis[]
  perinealAssessments PerinealAssessment[]
  evolutions          Evolution[]
  tasksCreated        Task[]               @relation("TaskCreatedBy")
  tasksAssigned       Task[]               @relation("TaskAssignedTo")

  @@unique([organizationId, personId])
  @@map("organization_users")
}

// ──────────────────────────────────────────────
// Patient
// ──────────────────────────────────────────────

enum PatientStatus {
  ACTIVE
  INACTIVE
}

model Patient {
  id                  String        @id @default(uuid())
  organizationId      String        @map("organization_id")
  name                String
  cpf                 String?
  birthDate           DateTime?     @map("birth_date")
  email               String?
  phone               String?
  gender              String?
  addressCep          String?       @map("address_cep")
  addressStreet       String?       @map("address_street")
  addressNumber       String?       @map("address_number")
  addressComplement   String?       @map("address_complement")
  addressNeighborhood String?       @map("address_neighborhood")
  addressCity         String?       @map("address_city")
  addressState        String?       @map("address_state")
  notes               String?
  status              PatientStatus @default(ACTIVE) @map("status")
  deletedAt           DateTime?     @map("deleted_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  organization        Organization         @relation(fields: [organizationId], references: [id])
  appointments        Appointment[]
  anamneses           Anamnesis[]
  perinealAssessments PerinealAssessment[]
  evolutions          Evolution[]
  financialRecords    FinancialRecord[]
  treatmentPackages   TreatmentPackage[]

  @@index([organizationId, deletedAt])
  @@index([organizationId, name, deletedAt])
  @@index([organizationId, status, deletedAt])
  @@map("patients")
}

// ──────────────────────────────────────────────
// Procedure
// ──────────────────────────────────────────────

model Procedure {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  name            String
  durationMinutes Int      @map("duration_minutes")
  price           Decimal  @db.Decimal(10, 2)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization               Organization                @relation(fields: [organizationId], references: [id])
  appointments               Appointment[]
  treatmentPackageProcedures TreatmentPackageProcedure[]

  @@map("procedures")
}

// ──────────────────────────────────────────────
// Appointment (Agenda)
// ──────────────────────────────────────────────

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CANCELED
  DONE
}

model Appointment {
  id                 String            @id @default(uuid())
  organizationId     String            @map("organization_id")
  patientId          String            @map("patient_id")
  professionalId     String            @map("professional_id")
  procedureId        String            @map("procedure_id")
  treatmentPackageId String?           @map("treatment_package_id")
  startAt            DateTime          @map("start_at")
  endAt              DateTime          @map("end_at")
  status             AppointmentStatus @default(SCHEDULED)
  notes              String?
  recurrenceGroupId  String?           @map("recurrence_group_id") @db.Uuid
  recurrenceIndex    Int?              @map("recurrence_index")
  deletedAt          DateTime?         @map("deleted_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  organization     Organization      @relation(fields: [organizationId], references: [id])
  patient          Patient           @relation(fields: [patientId], references: [id])
  professional     OrganizationUser  @relation(fields: [professionalId], references: [id])
  procedure        Procedure         @relation(fields: [procedureId], references: [id])
  treatmentPackage TreatmentPackage? @relation(fields: [treatmentPackageId], references: [id])
  evolution        Evolution?
  financialRecords FinancialRecord[]

  @@index([organizationId, startAt, endAt, deletedAt])
  @@index([organizationId, professionalId, startAt, deletedAt])
  @@index([organizationId, patientId, deletedAt])
  @@map("appointments")
}

// ──────────────────────────────────────────────
// AgendaBlock (Bloqueio de Agenda)
// ──────────────────────────────────────────────

model AgendaBlock {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  professionalId String   @map("professional_id")
  title          String
  startAt        DateTime @map("start_at")
  endAt          DateTime @map("end_at")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id])
  professional OrganizationUser @relation(fields: [professionalId], references: [id])

  @@index([organizationId, startAt, endAt])
  @@index([organizationId, professionalId, startAt])
  @@map("agenda_blocks")
}

// ──────────────────────────────────────────────
// Anamnesis
// ──────────────────────────────────────────────

model Anamnesis {
  id              String              @id @default(uuid())
  organizationId  String              @map("organization_id")
  patientId       String              @map("patient_id")
  professionalId  String              @map("professional_id")
  data            Json
  legalBasis      SensitiveLegalBasis @default(HEALTH_PROTECTION) @map("legal_basis")
  consentId       String?             @map("consent_id")
  legalBasisNotes String?             @map("legal_basis_notes")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id])
  patient      Patient          @relation(fields: [patientId], references: [id])
  professional OrganizationUser @relation(fields: [professionalId], references: [id])

  @@index([organizationId, patientId])
  @@index([organizationId, createdAt])
  @@map("anamneses")
}

// ──────────────────────────────────────────────
// PerinealAssessment
// Avaliação Cinesiológico-Funcional do Assoalho Pélvico (perineo.net)
// ──────────────────────────────────────────────

model PerinealAssessment {
  id              String              @id @default(uuid())
  organizationId  String              @map("organization_id")
  patientId       String              @map("patient_id")
  professionalId  String              @map("professional_id")
  data            Json
  legalBasis      SensitiveLegalBasis @default(HEALTH_PROTECTION) @map("legal_basis")
  consentId       String?             @map("consent_id")
  legalBasisNotes String?             @map("legal_basis_notes")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id])
  patient      Patient          @relation(fields: [patientId], references: [id])
  professional OrganizationUser @relation(fields: [professionalId], references: [id])

  @@index([organizationId, patientId])
  @@index([organizationId, createdAt])
  @@map("perineal_assessments")
}

// ──────────────────────────────────────────────
// Evolution
// ──────────────────────────────────────────────

model Evolution {
  id             String              @id @default(uuid())
  organizationId String              @map("organization_id")
  patientId      String              @map("patient_id")
  professionalId String              @map("professional_id")
  appointmentId  String?             @unique @map("appointment_id")
  description    String
  evolutionDate  DateTime            @default(now()) @map("evolution_date")
  legalBasis     SensitiveLegalBasis @default(HEALTH_PROTECTION) @map("legal_basis")
  consentId      String?             @map("consent_id")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id])
  patient      Patient          @relation(fields: [patientId], references: [id])
  professional OrganizationUser @relation(fields: [professionalId], references: [id])
  appointment  Appointment?     @relation(fields: [appointmentId], references: [id])

  @@index([organizationId, patientId])
  @@index([organizationId, evolutionDate])
  @@map("evolutions")
}

// ──────────────────────────────────────────────
// AuditLog
// ──────────────────────────────────────────────

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  action         String
  entity         String
  entityId       String?  @map("entity_id")
  details        Json?
  ipAddress      String?  @map("ip_address")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId])
  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ──────────────────────────────────────────────
// FinancialRecord
// ──────────────────────────────────────────────

enum FinancialType {
  INCOME
  EXPENSE
}

enum FinancialStatus {
  PENDING
  PAID
}

model FinancialRecord {
  id                 String          @id @default(uuid())
  organizationId     String          @map("organization_id")
  patientId          String?         @map("patient_id")
  appointmentId      String?         @map("appointment_id")
  treatmentPackageId String?         @map("treatment_package_id")
  amount             Decimal         @db.Decimal(10, 2)
  type               FinancialType
  status             FinancialStatus @default(PENDING)
  paymentMethod      String?         @map("payment_method")
  description        String?
  dueDate            DateTime?       @map("due_date")
  installment        Int?
  installmentTotal   Int?            @map("installment_total")
  recurrenceGroupId  String?         @map("recurrence_group_id") @db.Uuid
  recurrenceIndex    Int?            @map("recurrence_index")
  deletedAt          DateTime?       @map("deleted_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  organization     Organization      @relation(fields: [organizationId], references: [id])
  patient          Patient?          @relation(fields: [patientId], references: [id])
  appointment      Appointment?      @relation(fields: [appointmentId], references: [id])
  treatmentPackage TreatmentPackage? @relation(fields: [treatmentPackageId], references: [id])

  @@index([organizationId, createdAt, deletedAt])
  @@index([organizationId, status, type, deletedAt])
  @@index([organizationId, dueDate, deletedAt])
  @@map("financial_records")
}

// ──────────────────────────────────────────────
// TreatmentPackage (Pacote de Tratamento)
// ──────────────────────────────────────────────

enum TreatmentPackageStatus {
  ACTIVE
  COMPLETED
  CANCELED
}

model TreatmentPackage {
  id             String                 @id @default(uuid())
  organizationId String                 @map("organization_id")
  patientId      String                 @map("patient_id")
  name           String
  totalSessions  Int                    @map("total_sessions")
  usedSessions   Int                    @default(0) @map("used_sessions")
  totalPrice     Decimal                @map("total_price") @db.Decimal(10, 2)
  status         TreatmentPackageStatus @default(ACTIVE)
  notes          String?
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  organization     Organization                @relation(fields: [organizationId], references: [id])
  patient          Patient                     @relation(fields: [patientId], references: [id])
  procedures       TreatmentPackageProcedure[]
  appointments     Appointment[]
  financialRecords FinancialRecord[]

  @@index([organizationId, patientId])
  @@index([organizationId, createdAt])
  @@map("treatment_packages")
}

model TreatmentPackageProcedure {
  id                 String @id @default(uuid())
  treatmentPackageId String @map("treatment_package_id")
  procedureId        String @map("procedure_id")

  treatmentPackage TreatmentPackage @relation(fields: [treatmentPackageId], references: [id], onDelete: Cascade)
  procedure        Procedure        @relation(fields: [procedureId], references: [id])

  @@unique([treatmentPackageId, procedureId])
  @@map("treatment_package_procedures")
}

// ──────────────────────────────────────────────
// ClinicDocument (Módulo de Documentos)
// ──────────────────────────────────────────────

enum ClinicDocumentType {
  FILE
  GENERATED
}

enum GeneratedDocumentTemplate {
  ANAMNESIS_REPORT
  APPOINTMENT_CERTIFICATE
  ATTENDANCE_TERM
  EVOLUTION_SUMMARY
}

model ClinicDocument {
  id             String             @id @default(uuid())
  organizationId String?            @map("organization_id")
  name           String
  description    String?
  category       String?
  type           ClinicDocumentType

  fileKey  String? @map("file_key")
  mimeType String? @map("mime_type")
  fileSize Int?    @map("file_size")

  templateType GeneratedDocumentTemplate? @map("template_type")

  active    Boolean  @default(true)
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId, active])
  @@map("clinic_documents")
}

// ──────────────────────────────────────────────
// Task
// ──────────────────────────────────────────────

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  title          String
  description    String?
  status         TaskStatus   @default(PENDING)
  priority       TaskPriority @default(MEDIUM)
  dueDate        DateTime?    @map("due_date")
  createdById    String       @map("created_by_id")
  assignedToId   String       @map("assigned_to_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id])
  createdBy    OrganizationUser @relation("TaskCreatedBy", fields: [createdById], references: [id])
  assignedTo   OrganizationUser @relation("TaskAssignedTo", fields: [assignedToId], references: [id])

  @@map("tasks")
}

// ──────────────────────────────────────────────
// DeviceToken — token de push (Expo) por dispositivo mobile
// ──────────────────────────────────────────────

enum DevicePlatform {
  IOS
  ANDROID
}

model DeviceToken {
  id            String         @id @default(uuid())
  personId      String         @map("person_id")
  expoPushToken String         @unique @map("expo_push_token")
  platform      DevicePlatform
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@map("device_tokens")
}

// ──────────────────────────────────────────────
// Patient Portal — login e vínculo da paciente
// Tabelas isoladas: sem @relation para Patient/Organization (referência solta,
// ver docs/superpowers/specs/2026-09-18-app-paciente-fundacao-design.md)
// ──────────────────────────────────────────────

enum PatientAccountStatus {
  ACTIVE
  BLOCKED
}

model PatientAccount {
  id           String               @id @default(uuid())
  cpf          String               @unique
  passwordHash String?              @map("password_hash")
  status       PatientAccountStatus @default(ACTIVE)
  createdAt    DateTime             @default(now()) @map("created_at")
  activatedAt  DateTime?            @map("activated_at")

  @@map("patient_accounts")
}

enum PatientAccountLinkStatus {
  PENDING_CONSENT
  ACTIVE
  DECLINED
}

model PatientAccountLink {
  id               String                   @id @default(uuid())
  patientAccountId String                   @map("patient_account_id")
  patientId        String                   @map("patient_id")
  organizationId   String                   @map("organization_id")
  status           PatientAccountLinkStatus @default(PENDING_CONSENT)
  invitedAt        DateTime                 @default(now()) @map("invited_at")
  confirmedAt      DateTime?                @map("confirmed_at")

  @@unique([patientId])
  @@index([patientAccountId, status])
  @@map("patient_account_links")
}

enum PatientConsentAction {
  REQUESTED
  ACCEPTED
  DECLINED
  RESENT
}

enum PatientConsentActorType {
  PATIENT
  PROFESSIONAL
}

model PatientConsentAudit {
  id                   String                  @id @default(uuid())
  patientAccountLinkId String                  @map("patient_account_link_id")
  action               PatientConsentAction
  actorType            PatientConsentActorType @map("actor_type")
  actorId              String                  @map("actor_id")
  createdAt            DateTime                @default(now()) @map("created_at")

  @@index([patientAccountLinkId])
  @@map("patient_consent_audits")
}

model PatientTreatmentPlan {
  id                String   @id @default(uuid())
  patientId         String   @unique @map("patient_id")
  organizationId    String   @map("organization_id")
  features          Json     @default("{}")
  updatedByPersonId String?  @map("updated_by_person_id")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("patient_treatment_plans")
}

// ──────────────────────────────────────────────
// VoidingDiaryEntry (Diário miccional — registro da paciente)
// ──────────────────────────────────────────────

model VoidingDiaryEntry {
  id                     String                @id @default(uuid())
  patientId              String                @map("patient_id")
  organizationId         String                @map("organization_id")
  recordedAt             DateTime              @map("recorded_at")
  urineVolumeMl          Int?                  @map("urine_volume_ml")
  voidingDurationSeconds Int?                  @map("voiding_duration_seconds")
  fluidIntakeMl          Int?                  @map("fluid_intake_ml")
  hadLeakage             Boolean               @default(false) @map("had_leakage")
  leakageAmount          VoidingLeakageAmount? @map("leakage_amount")
  changedPad             Boolean               @default(false) @map("changed_pad")
  deletedAt              DateTime?             @map("deleted_at")
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")

  @@index([organizationId, patientId, recordedAt])
  @@map("voiding_diary_entries")
}

// ──────────────────────────────────────────────
// BowelDiaryEntry (Diário evacuatório — registro da paciente)
// ──────────────────────────────────────────────

model BowelDiaryEntry {
  id                           String            @id @default(uuid())
  patientId                    String            @map("patient_id")
  organizationId               String            @map("organization_id")
  recordedAt                   DateTime          @map("recorded_at")
  hadBowelMovement             Boolean           @default(false) @map("had_bowel_movement")
  bristolType                  String?           @map("bristol_type")
  effort                       BowelEffort?
  sensation                    BowelSensation?
  bowelMovementDurationSeconds Int?              @map("bowel_movement_duration_seconds")
  hadLeakage                   Boolean           @default(false) @map("had_leakage")
  leakageType                  BowelLeakageType? @map("leakage_type")
  deletedAt                    DateTime?         @map("deleted_at")
  createdAt                    DateTime          @default(now()) @map("created_at")
  updatedAt                    DateTime          @updatedAt @map("updated_at")

  @@index([organizationId, patientId, recordedAt])
  @@map("bowel_diary_entries")
}
